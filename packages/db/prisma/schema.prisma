// Soma Prisma schema — CLAUDE.md §3 domain model.
// Non-negotiables enforced here:
//  - every tenant-owned table carries schoolId (+ index)
//  - money is BigInt minor units + ISO-4217 currency string
//  - LedgerEntry is append-only (Postgres trigger in migration + client guard)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  CHURNED
}

enum Role {
  OWNER
  BURSAR
  TEACHER
  VIEWER
  PARENT
}

enum StudentStatus {
  ENROLLED
  LEFT
  GRADUATED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

enum PaymentChannel {
  MTN_MOMO
  AIRTEL_MONEY
  BANK
  CASH
  OTHER
}

enum ProviderType {
  SCHOOLPAY_IMPORT
  MTN_MOMO
  AIRTEL_MONEY
  BANK
  SOMA_RAIL
}

enum ReconMethod {
  AUTO
  MANUAL
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

enum LedgerEntryType {
  PAYMENT_RECEIVED
  PAYMENT_REVERSED
  INVOICE_ISSUED
  INVOICE_VOIDED
  ADJUSTMENT
  SETTLEMENT
}

model SchoolGroup {
  id      String   @id @default(uuid())
  name    String
  schools School[]
}

enum SchoolMode {
  LIVE
  TEST
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// An admission application (CLAUDE.md §7 F13).
///
/// Filed by someone with no Soma account, so the only handle is a phone plus
/// a one-time code. The public `reference` is what an applicant quotes to
/// check progress — it is unguessable, because possession of it plus the
/// phone is what proves ownership.
model Application {
  id             String            @id @default(uuid())
  schoolId       String
  /// Public tracking code, e.g. "APP-7F3K-2M9Q".
  reference      String            @unique
  applicantFirst String
  applicantLast  String
  dateOfBirth    DateTime?
  /// Class or year group applied for.
  appliedFor     String
  guardianName   String
  /// E.164. The login handle for checking status.
  guardianPhone  String
  guardianEmail  String?
  status         ApplicationStatus @default(SUBMITTED)
  /// Set when a place is offered and the applicant becomes a Student.
  studentId      String?
  notes          String?
  otpHash        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int               @default(0)
  submittedAt    DateTime          @default(now())
  decidedAt      DateTime?
  decidedBy      String?

  events ApplicationEvent[]

  @@index([schoolId, status])
  @@index([guardianPhone])
}

/// Append-only history of an application's progress. An admissions decision
/// is disputable, so the trail is immutable like the ledger.
model ApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletEntryType {
  DEPOSIT
  WITHDRAWAL
  /// Bursar hands physical cash to the student.
  CASHOUT
  ADJUSTMENT
  REVERSAL
}

/// A student's pocket-money wallet (CLAUDE.md §7 F14).
///
/// `balanceMinor` is a cached projection of the append-only entries below.
/// It is updated only by conditional writes that also assert the previous
/// balance, so two concurrent withdrawals cannot both succeed.
model Wallet {
  id          String       @id @default(uuid())
  schoolId    String
  studentId   String       @unique
  balanceMinor BigInt      @default(0)
  currency    String
  status      WalletStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  entries WalletEntry[]

  @@index([schoolId])
}

/// One movement of pocket money. Append-only, enforced by trigger.
///
/// `balanceAfterMinor` is recorded per entry so a statement can be audited
/// line by line without replaying every prior row.
model WalletEntry {
  id                String          @id @default(uuid())
  walletId          String
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  schoolId          String
  type              WalletEntryType
  /// Always positive. Direction comes from `type`, so a sign error cannot
  /// silently invert a withdrawal into a deposit.
  amountMinor       BigInt
  balanceAfterMinor BigInt
  currency          String
  /// Set when the deposit arrived through the payments context.
  paymentId         String?
  /// Staff member for a cashout or adjustment; null for a rail deposit.
  actorId           String?
  reference         String?
  note              String?
  createdAt         DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([schoolId, createdAt])
}

model School {
  id            String       @id @default(uuid())
  schoolGroupId String?
  schoolGroup   SchoolGroup? @relation(fields: [schoolGroupId], references: [id])
  name          String
  country       String
  currency      String
  timezone      String
  status        SchoolStatus @default(ACTIVE)
  /// A sandbox is a TEST-mode school. Making the sandbox a tenant rather than
  /// a parallel mechanism means live/test isolation rides on the tenant
  /// boundary that is already enforced and tested.
  mode          SchoolMode   @default(LIVE)
  /// The live school a sandbox belongs to, so a developer's test tenant can
  /// be found from their real one.
  sandboxOfId   String?
  createdAt     DateTime     @default(now())

  users         User[]
  students      Student[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  apiKeys       ApiKey[]

  @@index([sandboxOfId])
}

/// A scoped credential for the public API (CLAUDE.md §7 F12).
///
/// The secret is never stored. `prefix` is the indexed lookup handle and
/// `hash` is a SHA-256 of the full key, compared in constant time.
///
/// SHA-256 rather than Argon2 is deliberate and is NOT a weakening of §8.3.
/// Argon2 exists to make low-entropy human passwords expensive to guess. An
/// API key is 256 bits of CSPRNG output, so there is no dictionary to walk,
/// and a slow KDF on every single API request would cost far more than it
/// buys. Passwords still use Argon2id.
model ApiKey {
  id         String     @id @default(uuid())
  schoolId   String
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  mode       SchoolMode
  /// Displayable, non-secret head of the key: "sk_test_a1b2c3d4".
  prefix     String     @unique
  hash       String
  /// Least privilege: "students:read", "payments:write", and so on.
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String?
  createdAt  DateTime   @default(now())

  @@index([schoolId, revokedAt])
}

/// Replay protection for public API writes (CLAUDE.md §8.4).
///
/// The stored response is replayed verbatim for a repeated key, so a client
/// retrying after a timeout gets the original answer instead of creating a
/// second payment.
model IdempotencyRecord {
  id             String   @id @default(uuid())
  schoolId       String
  key            String
  endpoint       String
  /// Hash of the request body. A reused key with a different body is a
  /// client bug and is rejected rather than silently answered.
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([schoolId, key])
  @@index([createdAt])
}

model User {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  email        String
  passwordHash String
  role         Role
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([schoolId, email])
  @@index([schoolId])
}

model Student {
  id          String        @id @default(uuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  /// School-assigned payment code, printed on fee statements.
  externalRef String?
  /// Registration number — a separate identifier from the payment code.
  regNumber   String?
  firstName   String
  middleName  String?
  lastName    String
  className   String?
  status      StudentStatus @default(ENROLLED)
  createdAt   DateTime      @default(now())

  guardians   GuardianStudent[]
  invoices    Invoice[]
  payments    Payment[]
  enrolments  Enrolment[]

  @@unique([schoolId, externalRef])
  @@unique([schoolId, regNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

/// A parent's login, deliberately NOT tenant-scoped.
///
/// Every other identity in Soma is bound to one school. A parent is the
/// exception: children at two schools are still one person with one phone.
/// The blast radius is contained because this record grants nothing on its
/// own — access is derived by walking Guardian → GuardianStudent, so a parent
/// only ever reaches students explicitly linked to them, never a school.
model GuardianIdentity {
  id           String    @id @default(uuid())
  /// E.164. The login handle, and unique across the whole platform.
  phone        String    @unique
  otpHash      String?
  otpExpiresAt DateTime?
  /// Consecutive failed OTP attempts; resets on success.
  otpAttempts  Int       @default(0)
  lastLoginAt  DateTime?
  locale       String    @default("en")
  createdAt    DateTime  @default(now())

  guardians   Guardian[]
  payerProfiles PayerProfile[]
  reminderPrefs ReminderPreference[]
  reminderLogs  ReminderLog[]
}

model Guardian {
  id         String            @id @default(uuid())
  schoolId   String
  /// Links this school's record to the person's platform-wide login.
  identityId String?
  identity   GuardianIdentity? @relation(fields: [identityId], references: [id])
  name       String
  phone      String
  email      String?
  locale     String            @default("en")
  students   GuardianStudent[]

  @@index([schoolId])
  @@index([identityId])
}

/// A mobile-money number a parent pays from, saved so they need not retype it.
model PayerProfile {
  id         String           @id @default(uuid())
  identityId String
  identity   GuardianIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  /// "My MTN line", "Dad's Airtel".
  label      String
  msisdn     String
  channel    PaymentChannel
  isDefault  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@unique([identityId, msisdn])
  @@index([identityId])
}

enum ReminderChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  SENT
  FAILED
  SUPPRESSED_OPT_OUT
  SUPPRESSED_RATE_LIMIT
}

/// Per-channel consent. Absence of a row means the default in code applies;
/// an explicit row always wins, so an opt-out can never be lost to a default.
model ReminderPreference {
  identityId String
  identity   GuardianIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  channel    ReminderChannel
  enabled    Boolean
  updatedAt  DateTime         @updatedAt

  @@id([identityId, channel])
}

/// Every reminder attempt, including the ones we chose not to send.
/// Suppressions are recorded too — proving a parent was NOT messaged after
/// opting out is the point.
model ReminderLog {
  id         String           @id @default(uuid())
  identityId String
  identity   GuardianIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  schoolId   String
  studentId  String?
  channel    ReminderChannel
  kind       String
  status     ReminderStatus
  /// Never the message body — it contains a child's name and balance.
  detail     String?
  createdAt  DateTime         @default(now())

  @@index([identityId, createdAt])
  @@index([schoolId, createdAt])
}

enum GuardianRelation {
  MOTHER
  FATHER
  GUARDIAN
  SPONSOR
  OTHER
}

model GuardianStudent {
  guardianId String
  guardian   Guardian         @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation   GuardianRelation @default(GUARDIAN)
  /// The contact reminders go to first.
  isPrimary  Boolean          @default(false)

  @@id([guardianId, studentId])
  @@index([studentId])
}

enum TermStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

/// An academic term. Invoices and enrolments hang off it.
model Term {
  id        String     @id @default(uuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    TermStatus @default(UPCOMING)
  createdAt DateTime   @default(now())

  enrolments     Enrolment[]
  invoices       Invoice[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

/// A year group: P5, S2. Streams divide it.
model SchoolClass {
  id       String   @id @default(uuid())
  schoolId String
  name     String
  /// Ordering hint for reports, e.g. 5 for P5.
  level    Int?
  createdAt DateTime @default(now())

  streams       Stream[]
  enrolments    Enrolment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A division within a class: "P5 East".
model Stream {
  id      String      @id @default(uuid())
  classId String
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name    String

  enrolments Enrolment[]

  @@unique([classId, name])
}

enum EnrolmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

/// A student's placement in a class for one term.
model Enrolment {
  id        String          @id @default(uuid())
  schoolId  String
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass     @relation(fields: [classId], references: [id])
  streamId  String?
  stream    Stream?         @relation(fields: [streamId], references: [id])
  status    EnrolmentStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  // A student sits in exactly one class per term.
  @@unique([studentId, termId])
  @@index([schoolId, termId])
  @@index([classId, termId])
}

/// A billable line a school can charge: tuition, lunch, transport.
model FeeItem {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  amountMinor BigInt
  currency    String
  /// Optional items are billed only when a student opts in.
  mandatory   Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  structureLines FeeStructureLine[]

  @@unique([schoolId, name])
  @@index([schoolId, active])
}

/// The set of fees charged to one class for one term.
model FeeStructure {
  id        String      @id @default(uuid())
  schoolId  String
  termId    String
  term      Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  lines FeeStructureLine[]

  @@unique([termId, classId])
  @@index([schoolId])
}

model FeeStructureLine {
  id          String       @id @default(uuid())
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeItemId   String
  feeItem     FeeItem      @relation(fields: [feeItemId], references: [id])
  /// Overrides the fee item's default when a class is charged differently.
  amountMinor BigInt?

  @@unique([structureId, feeItemId])
}

model Invoice {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  /// Human-readable term label, kept for legacy imports.
  term           String
  termId         String?
  termRef        Term?         @relation(fields: [termId], references: [id])
  amountDueMinor BigInt
  /// Running total of confirmed allocations. Derived, but stored so the
  /// bursar's arrears view does not aggregate the whole ledger on every read.
  amountPaidMinor BigInt       @default(0)
  currency       String
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines   InvoiceLine[]
  matches ReconciliationMatch[]

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([schoolId, status, dueDate])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amountMinor BigInt
  /// Which fee item produced this line, when it came from a structure.
  feeItemId   String?

  @@index([invoiceId])
}

model Payment {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id])
  studentId   String?
  student     Student?       @relation(fields: [studentId], references: [id])
  amountMinor BigInt
  currency    String
  channel     PaymentChannel
  /// Soma's own reference — the idempotency key across every rail.
  somaRef     String         @unique
  /// Rail-side reference, absent until the provider accepts the initiation.
  providerRef String?
  receiptNo   String?
  paidAt      DateTime?
  status      PaymentStatus  @default(PENDING)
  /// Payer MSISDN. Never logged raw; redacted to the last 4 digits.
  payerPhone  String
  /// Name on the paying mobile-money account, when the rail reports it.
  /// A reconciliation signal — without it the matcher is nearly blind on
  /// payments that carry no code.
  payerName   String?
  /// Free text the payer or rail attached: reference, narration, message.
  narration   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  matches ReconciliationMatch[]

  // Idempotency: a provider reference can land at most once per school.
  @@unique([schoolId, providerRef])
  @@index([schoolId])
  @@index([schoolId, status])
}

/// A payer's validated intent to pay, created by step 1 of the two-step flow.
/// The token is the ONLY thing handed back pre-auth — it carries no PII, and
/// resolving it server-side is what lets step 2 know the student (CLAUDE.md §8.1).
model PaymentIntent {
  id        String   @id @default(uuid())
  /// Opaque high-entropy token. Stored hashed; the plaintext never touches the DB.
  tokenHash String   @unique
  schoolId  String
  studentId String
  expiresAt DateTime
  /// Single-use: set when step 2 consumes it.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A school's registered destination for outbound event delivery.
model WebhookEndpoint {
  id        String   @id @default(uuid())
  schoolId  String
  url       String
  /// HMAC-SHA256 signing secret. Env-grade material — never returned by any API.
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([schoolId])
}

/// One outbound event to one endpoint, retried until delivered or dead.
model WebhookDelivery {
  id             String          @id @default(uuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id])
  schoolId       String
  eventType      String
  payload        Json
  /// Stable across every retry — receivers dedupe on this (CLAUDE.md §8.4).
  idempotencyKey String          @unique
  attempts       Int             @default(0)
  status         WebhookStatus   @default(PENDING)
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, nextAttemptAt])
  @@index([schoolId])
}

/// Inbound provider callbacks, recorded before processing so a replayed
/// callback is recognized and ignored rather than double-counted.
model InboundCallback {
  id         String   @id @default(uuid())
  provider   String
  /// Provider's own event id. Unique per provider — the dedupe key.
  eventId    String
  somaRef    String?
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([somaRef])
}

/// Money actually landing in the school's bank account (F6).
model Settlement {
  id            String   @id @default(uuid())
  schoolId      String
  provider      String
  /// Provider's settlement batch identifier.
  batchRef      String
  amountMinor   BigInt
  currency      String
  settledAt     DateTime
  /// Sum of the payments Soma expected in this batch, for variance detection.
  expectedMinor BigInt
  createdAt     DateTime @default(now())

  @@unique([provider, batchRef])
  @@index([schoolId])
}

enum MatchStatus {
  /// Awaiting a bursar's decision in the review queue.
  PROPOSED
  CONFIRMED
  REJECTED
}

model ReconciliationMatch {
  id          String      @id @default(uuid())
  schoolId    String
  paymentId   String
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId   String
  method      ReconMethod
  /// The matcher's strategy, e.g. payment_code or fuzzy_name.
  strategy    String
  confidence  Float
  /// Why the matcher decided this — shown to the bursar reviewing it.
  evidence    String
  /// Partial payments mean an allocation is rarely the full invoice.
  amountMinor BigInt
  status      MatchStatus @default(PROPOSED)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@unique([paymentId, invoiceId])
  @@index([schoolId, status])
}

enum ReconEventType {
  MATCH_PROPOSED
  MATCH_AUTO_CONFIRMED
  MATCH_CONFIRMED
  MATCH_REJECTED
  PAYMENT_UNMATCHED
  ALLOCATION_APPLIED
}

/// Append-only trail of every reconciliation decision.
///
/// Reconciliation is the product's trust core: when a school disputes where
/// money went, this table is the answer. Rows are never updated or deleted —
/// enforced by trigger, like LedgerEntry.
model ReconciliationAudit {
  id        String         @id @default(uuid())
  schoolId  String
  paymentId String?
  invoiceId String?
  studentId String?
  matchId   String?
  event     ReconEventType
  /// Machine-readable detail: scores, runner-up, allocation amounts.
  detail    Json
  /// User id for a human decision; null when the engine acted.
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([schoolId, createdAt])
  @@index([paymentId])
}

model PaymentProvider {
  id       String       @id @default(uuid())
  schoolId String?
  type     ProviderType
  config   Json
}

model WebhookEvent {
  id        String           @id @default(uuid())
  direction WebhookDirection
  type      String
  payload   Json
  signature String?
  attempts  Int              @default(0)
  status    WebhookStatus    @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

/// Append-only. Corrections are new entries — never edits or deletes.
/// Enforced by a Postgres trigger (see migration) AND the client guard in src/client.ts.
model LedgerEntry {
  id          String          @id @default(uuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id])
  type        LedgerEntryType
  amountMinor BigInt
  currency    String
  refs        Json
  createdAt   DateTime        @default(now())

  @@index([schoolId, createdAt])
}
