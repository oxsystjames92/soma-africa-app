# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://soma:soma_local_dev@localhost:5434/soma

# ─── Redis / queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (identity context) ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=dummy_change_me_64_hex_chars
# Short-lived sessions per CLAUDE.md §5
JWT_EXPIRES_IN=15m

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
