# ─── Supabase ─────────────────────────────────────────────────────────────────
# Copy from: Supabase Dashboard → Project Settings → API
# NEVER commit real keys. service_role key is SERVER-ONLY (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://soma-africa.com

# ─── Lead notifications ───────────────────────────────────────────────────────
# Webhook secret must match the x-webhook-secret header on the Supabase webhook.
WEBHOOK_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL=
# EMAIL_FROM requires a Resend-verified domain, e.g. "Soma Africa <hello@soma-africa.com>"
EMAIL_FROM=
# Optional WhatsApp alerts via CallMeBot
NOTIFY_PHONE=
CALLMEBOT_API_KEY=

# ─── Leads dashboard (/dashboard) ─────────────────────────────────────────────
DASHBOARD_PASSWORD=
